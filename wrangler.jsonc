// Cloudflare settings for the Nuru website. Keep this file at the TOP of the GitHub repo, next to index.html.
// It tells Cloudflare: no server code, just publish the website files in this folder.
{
  "name": "nuru",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
