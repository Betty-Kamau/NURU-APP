// Cloudflare settings for the Nuru website. Cloudflare reads this file when it builds from GitHub.
// It tells Cloudflare: there is no server code, just publish the files in the "public" folder.
{
  "name": "nuru",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
